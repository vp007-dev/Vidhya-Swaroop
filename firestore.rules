// Firestore Security Rules
// Copy these rules to your Firebase Console -> Firestore Database -> Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contacts collection - only allow writes, no reads from client
    match /contacts/{document} {
      // Allow writes with validation
      allow create: if isValidContact(resource.data) 
                   && request.time > resource.data.timestamp - duration.value(10, 's')
                   && request.time < resource.data.timestamp + duration.value(10, 's');
      
      // Deny all reads from client side
      allow read: if false;
      
      // Deny updates and deletes from client side
      allow update, delete: if false;
    }
    
    // Helper function to validate contact data
    function isValidContact(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'type', 'timestamp', 'status'])
             && data.name is string && data.name.size() > 0 && data.name.size() <= 100
             && data.email is string && data.email.matches('.*@.*\\..*')
             && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200
             && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
             && data.type in ['volunteer', 'donation', 'general', 'partnership']
             && data.status == 'new';
    }
    
    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}